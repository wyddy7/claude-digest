# digest_bot environment — copy to .env and fill in. NEVER commit real values.
# On the feat/paid-saas branch BOT_TOKEN MUST be a BotFather TEST/dev bot token,
# and SUPABASE_* MUST point at a local/dev project — never prod.

# Telegram
BOT_TOKEN=
CHAT_ID=

# Admin grants — numeric Telegram user id that may run /give_pro, /revoke_pro,
# /grant_trial. Default 0 disables the admin commands (they are silently ignored).
ADMIN_ID=0

# LLM
OPENROUTER_KEY=

# Supabase (HTTP API)
SUPABASE_URL=
SUPABASE_KEY=

# Networking / logging
HTTPS_PROXY=
LOG_LEVEL=INFO
